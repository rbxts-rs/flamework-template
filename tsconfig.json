{
	"compilerOptions": {
		// required
		"allowSyntheticDefaultImports": true,
		"jsx": "react",
		"jsxFactory": "React.createElement",
		"jsxFragmentFactory": "React.Fragment",
		"module": "preserve",
		"moduleResolution": "bundler",
		"noLib": true,
		"resolveJsonModule": true,
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"moduleDetection": "force",
		"strict": true,
		"target": "ESNext",
		"typeRoots": [
			"node_modules/@rbxts",
			"node_modules/@flamework-experimental",
			"node_modules/@your-scope"
		],
		// TypeScript 7 loads no type-root package by itself: these are the globals roblox-ts needs.
		"types": ["types", "compiler-types"],

		// configurable
		"rootDir": "src",
		"outDir": "out",
		// Imports from src/, such as "shared/fixtures/players" (what "baseUrl": "src" did in
		// TypeScript 5). The others: package/ has a node_modules of its own, with links to the same
		// packages. roblox-ts writes an import through the first link to a package that TypeScript
		// met, which could be one in package/, outside the game's node_modules: these keep every
		// import of a package the plugin also imports on the game's own link. Add a line for each
		// package the plugin's typings import.
		"paths": {
			"*": ["./src/*"],
			"@flamework-experimental/core": ["./node_modules/@flamework-experimental/core"],
			"@rbxts/services": ["./node_modules/@rbxts/services"]
		},

		"plugins": [
			// Turns Flamework on in rbxtsc-fw, which has it compiled in.
			{
				"transform": "@flamework-experimental/transformer"
			}
		]
	},
	// Only the game: package/ is compiled on its own, by `rbxtsc-fw -p package`.
	"include": ["src"]
}
