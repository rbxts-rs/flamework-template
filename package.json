{
	"name": "flamework-plugin-template",
	"version": "0.1.0",
	"private": true,
	"description": "A Flamework v2 plugin package (package/) and the game that tests it in Studio, built with rbxts-rs (rbxtsc-fw).",
	"workspaces": ["package"],
	"scripts": {
		"build": "node compiler/rbxtsc.mjs build -p package && node compiler/rbxtsc.mjs build",
		"build:package": "node compiler/rbxtsc.mjs build -p package",
		"watch": "node compiler/rbxtsc.mjs -w",
		"watch:package": "node compiler/rbxtsc.mjs -p package -w",
		"typecheck": "tsc --noEmit -p package --skipLibCheck && tsc --noEmit -p . --skipLibCheck",
		"serve": "rojo serve",
		"place": "rojo build -o place.rbxl",
		"test": "bun scripts/test.mjs",
		"format": "prettier --write src package/src"
	},
	"dependencies": {
		"@flamework-experimental/core": "2.0.0-beta.1",
		"@flamework-experimental/testing": "2.0.0-beta.1",
		"@rbxts/services": "^1.6.0",
		"@your-scope/player-events": "workspace:*"
	},
	"devDependencies": {
		"@rbxts/compiler-types": "https://github.com/rbxts-rs/compiler-types/releases/download/v3.0.0-types.1-ts7.0/rbxts-compiler-types-3.0.0-types.1-ts7.0.tgz",
		"@rbxts/types": "^1.0.955",
		"prettier": "^3.8.1",
		"typescript": "^7.0.2"
	}
}
