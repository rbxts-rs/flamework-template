{
	"compilerOptions": {
		// required
		"allowSyntheticDefaultImports": true,
		"module": "preserve",
		"moduleResolution": "bundler",
		"noLib": true,
		"resolveJsonModule": true,
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"moduleDetection": "force",
		"strict": true,
		"target": "ESNext",
		"typeRoots": ["node_modules/@rbxts", "node_modules/@flamework-experimental"],
		// TypeScript 7 loads no type-root package by itself: these are the globals roblox-ts needs.
		"types": ["types", "compiler-types"],

		// a package
		"declaration": true,
		// Leaves out what is marked @internal, such as PlayerRoster.add, from the published typings.
		"stripInternal": true,

		// configurable
		"rootDir": "src",
		"outDir": "out",
		// Each import of a package this one shares with its dependencies goes through this folder's own
		// node_modules. roblox-ts writes an import through the first link to a package that TypeScript
		// met, and with bun's linker core's own links to @rbxts packages could otherwise come first.
		"paths": {
			"@flamework-experimental/core": ["./node_modules/@flamework-experimental/core"],
			"@rbxts/services": ["./node_modules/@rbxts/services"]
		},

		"plugins": [
			// Turns Flamework on in rbxtsc-fw, which has it compiled in.
			{
				"transform": "@flamework-experimental/transformer"
			}
		]
	},
	"include": ["src"]
}
